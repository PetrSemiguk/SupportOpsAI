# Local-only demo values. Use separate generated secrets for any deployment.
POSTGRES_USER=supportops
POSTGRES_PASSWORD=supportops-local-only
POSTGRES_DB=supportops
DATABASE_URL=postgresql+psycopg://supportops:supportops-local-only@localhost:54329/supportops
# Set distinct, locally generated bearer tokens for the demo customers you use.
# DEMO_CUSTOMER_TOKENS={"demo-001":"replace-with-a-random-token"}
# DEMO_OPERATOR_TOKEN=replace-with-a-different-random-token
# N8N_COMPLETION_TOKEN=replace-with-a-separate-random-integration-token
# N8N_INTAKE_KEY=replace-with-a-separate-random-webhook-key

# Optional hosted model and tracing settings. Use private .env values.
# FOUNDRY_ENABLED=false
# FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# FOUNDRY_API_KEY=
# FOUNDRY_CHAT_DEPLOYMENT=
# FOUNDRY_EMBEDDING_DEPLOYMENT=
# FOUNDRY_MAX_COMPLETION_TOKENS=300
# SUPPORTOPS_LANGSMITH_ENABLED=false
# SUPPORTOPS_LANGSMITH_API_KEY=
# SUPPORTOPS_LANGSMITH_PROJECT=supportops-ai
