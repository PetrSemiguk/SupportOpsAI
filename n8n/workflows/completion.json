{
  "id": "SupportOpsFinish",
  "name": "SupportOps AI - Completion notifications",
  "active": false,
  "nodes": [
    {
      "id": "edc7cb75-86bf-443d-bcbb-6d7fa12ffab5",
      "name": "Poll completion queue",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "7cca8baa-6f57-4ea6-8c3c-bf17bc9b6651",
      "name": "Read pending completions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "url": "http://api:8000/api/integrations/completions?limit=25",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SupportOpsCompletion",
          "name": "SupportOps completion token"
        }
      }
    },
    {
      "id": "23f1867a-081c-47ac-8031-49f53d0cf0cd",
      "name": "Process each event",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "events",
        "options": {}
      }
    },
    {
      "id": "4958db5c-67f0-4476-a38c-8030c6d95346",
      "name": "Record demo notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://api:8000/api/integrations/completions/' + $json.ticket_id + '/ack' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SupportOpsCompletion",
          "name": "SupportOps completion token"
        }
      }
    }
  ],
  "connections": {
    "Poll completion queue": {
      "main": [
        [
          {
            "node": "Read pending completions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read pending completions": {
      "main": [
        [
          {
            "node": "Process each event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process each event": {
      "main": [
        [
          {
            "node": "Record demo notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
